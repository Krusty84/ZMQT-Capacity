{
  "name": "zmqt-capacity",
  "version": "1.0.0",
  "license": "MIT",
  "description": "A capacity analysis tool for ZMQ protocol implementations in your system.",
  "author": {
    "name": "Alexey Sedoykin",
    "url": "https://www.sedoykin.com/"
  },
  "homepage": "https://github.com/Krusty84/ZMQT-Capacity#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krusty84/ZMQT-Capacity.git"
  },
  "keywords": [
    "capacity",
    "zmq",
    "mqtt",
    "analysis",
    "ram",
    "cpu"
  ],
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "zmqt-capacity": "dist/tui/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/tui/main.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.1"
  }
}
